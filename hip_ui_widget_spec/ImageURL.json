{
  "type": "ImageURL",
  "mappings": [
    "@_node",
    {
      "type": "!figma-image",
      "format": "!url"
    }
  ],
  "userData": {
    "url": {
      "type": "string",
      "default": null,
      "description": "The URL of the image to display"
    },
    "scaling": {
      "type": "select",
      "default": "none",
      "options": [
        {
          "label": "Clipping",
          "value": "none"
        },
        {
          "label": "Scale Down",
          "value": "scaleDown"
        },
        {
          "label": "Fill & Squeeze",
          "value": "fill"
        },
        {
          "label": "Fill & Resize",
          "value": "contain"
        },
        {
          "label": "Scale to Cover",
          "value": "cover"
        },
        {
          "label": "Fill Width",
          "value": "fitWidth"
        },
        {
          "label": "Fill Height",
          "value": "fitHeight"
        }
      ],
      "description": "Controls the method used to scale the image within its container"
    }
  }
}